<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtKind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_sky"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="수학 탐험"
            android:textAppearance="@style/TextAppearance.Piyak.Caption"
            android:textColor="@color/sky_deep" />

        <Button
            android:id="@+id/btnSay"
            style="@style/Widget.Piyak.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/ic_volume_up_rounded"
            android:drawablePadding="5dp"
            android:text="읽어주기"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.25"
        android:textAppearance="@style/TextAppearance.Piyak.Section"
        android:textColor="@color/ink"
        android:textSize="23sp" />

    <com.piyak.english.ui.FormulaView
        android:id="@+id/formulaView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <com.piyak.english.ui.MathVisualView
        android:id="@+id/visual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:id="@+id/countBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_paper"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="그림을 하나씩 짚어 세어 보세요"
            android:textAppearance="@style/TextAppearance.Piyak.Caption"
            android:textColor="@color/ink_muted" />

        <Button
            android:id="@+id/btnCountReset"
            style="@style/Widget.Piyak.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="다시 세기"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/numberBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_choice"
            android:gravity="center"
            android:hint="?"
            android:minHeight="64dp"
            android:padding="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_muted"
            android:textSize="30sp"
            android:textStyle="bold" />

        <com.piyak.english.ui.NumberPadView
            android:id="@+id/numberPad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/choicesGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:columnCount="2"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_choice"
        android:hint="답을 입력하세요"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions|textVisiblePassword"
        android:minHeight="56dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_muted"
        android:textSize="18sp"
        android:visibility="gone" />
</LinearLayout>
