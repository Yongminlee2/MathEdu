<?xml version="1.0" encoding="utf-8"?>
<!--
  화면 크기에 따라 달라지는 치수.

  큰 화면(태블릿·폴더블)에서 내용이 가로로 끝까지 늘어지면 읽기 힘들다.
  좌우 여백만 키워서 **내용을 가운데로 모아 준다** — 레이아웃을 따로 만들지 않아도
  한 벌로 폰·태블릿을 다 감당할 수 있다.

  values/          폰 (기본)
  values-sw600dp/  7~8인치 태블릿·폴더블 펼침
  values-sw720dp/  10인치 이상 태블릿
-->
<resources>
    <!-- 화면 좌우 여백 -->
    <dimen name="screen_pad">16dp</dimen>
    <!-- 문제 화면처럼 여백이 더 좁아야 하는 곳 -->
    <dimen name="screen_pad_tight">12dp</dimen>
</resources>
